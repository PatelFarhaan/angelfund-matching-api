# Database
DATABASE_URI=mongodb://localhost:27017/admin
TEST_DATABASE_URI=mongodb://localhost:27017/admin
SECONDARY_DATABASE_URI=mongodb://localhost:27017/admin
PRIMARY_DATABASE_URI=mongodb://localhost:27017/admin

# Application
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
SERVER_DOMAIN=http://localhost:5000
PASSWORD_RESET_LINK_AGE=500

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Email
EMAIL_SENDER=Angelfund.ai <noreply@angelfund.ai>
EMAIL_SENDER_HELLO=Angelfund.ai <hello@angelfund.ai>
TECH_ERROR_RECIPIENT=admin@example.com

# ML Server
ML_SERVER_URL=http://localhost/ml/api/v1
MAIN_ML_SERVER=http://localhost
ML_SERVER_X_AUTH_KEY=your-ml-auth-key

# External APIs
RITEKIT_API_KEY=your-ritekit-api-key
INTERNAL_API_KEY=your-internal-api-key

# Logging
LOG_FILE=/var/log/angelfund/angelfund.log

# Seed Data
DEFAULT_USER_PASSWORD=changeme

# Misc
ANONYMOUS_PROFILE_PIC_URL=https://angelfund-profile-pics.s3-us-west-1.amazonaws.com/anonymous.png
TEST_SERVER_DOMAIN=http://localhost
MAIN_SERVER_DOMAIN=https://www.angelfund.ai
